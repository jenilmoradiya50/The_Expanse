# Environment Configuration Template for The Expanse
# Copy this file to .env.local for local development.
# Do NOT commit actual secrets or credentials to source control.

# -----------------------------------------------------------------------------
# Database
# Local Development: SQLite (Prisma)
# Production: Neon PostgreSQL (Connection pooling enabled)
# -----------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# Production Neon PostgreSQL placeholders (to be populated at deployment readiness):
# DATABASE_URL="postgresql://user:password@ep-placeholder.region.aws.neon.tech/neondb?sslmode=require"
# DIRECT_URL="postgresql://user:password@ep-placeholder.region.aws.neon.tech/neondb?sslmode=require"

# -----------------------------------------------------------------------------
# Authentication (NextAuth / JWT secret)
# -----------------------------------------------------------------------------
NEXTAUTH_SECRET="development-secret-key-change-in-production-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="The Expanse"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
