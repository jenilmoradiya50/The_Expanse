// =============================================================================
// The Expanse - Multi-Tenant Financial Management Architecture Schema
//
// Designed for seamless transition from SQLite (local dev) to Neon PostgreSQL (production).
// Supports: Multi-tenancy, RBAC, Indian GST, Financial Audits, Business & Personal Finance.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// 1. Identity, Users & Multi-Tenancy Core
// -----------------------------------------------------------------------------

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  name                 String?
  passwordHash         String?
  avatarUrl            String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  // Tenant Memberships
  memberships          Membership[]

  // Personal Finance Domain
  personalAccounts     PersonalAccount[]
  personalCategories   PersonalCategory[]
  personalTransactions PersonalTransaction[]
  personalBudgets      PersonalBudget[]

  // Audit Logs
  auditLogs            AuditLog[]

  @@index([email])
}

model Organization {
  id               String               @id @default(cuid())
  name             String
  slug             String               @unique
  logoUrl          String?
  currency         String               @default("INR")
  timezone         String               @default("Asia/Kolkata")
  fiscalYearStart  Int                  @default(4) // April for Indian financial year
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  // Multi-Tenancy & Access
  memberships      Membership[]
  invitations      OrganizationInvitation[]

  // Indian GST Compliance Profile
  gstProfile       GstProfile?

  // Business Domain
  customers        Customer[]
  vendors          Vendor[]
  products         Product[]
  orders           Order[]
  invoices         Invoice[]
  expenses         BusinessExpense[]
  payments         Payment[]
  documentSequences DocumentSequence[]

  // Audit History & Attachments
  auditLogs        AuditLog[]
  attachments      Attachment[]

  @@index([slug])
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("VIEWER") // OWNER, ADMIN, ACCOUNTANT, VIEWER
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model OrganizationInvitation {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           String       @default("VIEWER")
  token          String       @unique
  expiresAt      DateTime
  status         String       @default("PENDING") // PENDING, ACCEPTED, REVOKED, EXPIRED
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([token])
}

// -----------------------------------------------------------------------------
// 2. Indian GST Compliance Profile
// -----------------------------------------------------------------------------

model GstProfile {
  id                String       @id @default(cuid())
  organizationId    String       @unique
  gstin             String       @unique // 15-character Indian GSTIN
  legalName         String
  tradeName         String?
  pan               String       // 10-character PAN extracted from GSTIN
  stateCode         String       // 2-digit Indian State Code (e.g. 24 for Gujarat, 27 for Maharashtra)
  stateName         String
  isComposition     Boolean      @default(false)
  registeredAddress String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------------------
// 3. Immutable Financial Audit Trail
// -----------------------------------------------------------------------------

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String?
  action         String        // CREATE, UPDATE, DELETE, EXPORT, STATUS_CHANGE
  entity         String        // INVOICE, EXPENSE, CUSTOMER, VENDOR, GST_PROFILE, MEMBERSHIP
  entityId       String
  oldValues      String?       // JSON serialized state before change
  newValues      String?       // JSON serialized state after change
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// 4. Business Financial Management (Commercial Domain)
// -----------------------------------------------------------------------------

model Customer {
  id              String       @id @default(cuid())
  organizationId  String
  name            String
  email           String?
  phone           String?
  gstin           String?
  pan             String?
  stateCode       String?      // Place of Supply identification
  billingAddress  String?
  shippingAddress String?
  paymentTerms    String?      @default("NET_30")
  balance         Float        @default(0)
  isArchived      Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders          Order[]
  invoices        Invoice[]
  payments        Payment[]

  @@unique([organizationId, gstin])
  @@index([organizationId, isArchived])
}

model Vendor {
  id                String            @id @default(cuid())
  organizationId    String
  name              String
  email             String?
  phone             String?
  gstin             String?
  pan               String?
  address           String?
  stateCode         String?
  paymentTerms      String?           @default("NET_30")
  bankName          String?
  bankAccountNumber String?
  bankIfsc          String?
  balance           Float             @default(0)
  isArchived        Boolean           @default(false)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders            Order[]
  invoices          Invoice[]
  expenses          BusinessExpense[]
  payments          Payment[]

  @@unique([organizationId, gstin])
  @@index([organizationId, isArchived])
}

model Product {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  sku            String?
  description    String?
  type           String        @default("PRODUCT") // PRODUCT, SERVICE
  unit           String        @default("NOS")
  sellingPrice   Float         @default(0)
  purchasePrice  Float         @default(0)
  hsnSacCode     String
  gstRate        Float         @default(18)
  isActive       Boolean       @default(true)
  isArchived     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  invoiceItems   InvoiceItem[]

  @@unique([organizationId, sku])
  @@index([organizationId, isActive, isArchived])
}

model Order {
  id                   String        @id @default(cuid())
  organizationId       String
  orderNumber          String        // e.g. SO-2026-001 or PO-2026-001
  type                 String        @default("SALES") // SALES, PURCHASE
  customerId           String?
  vendorId             String?
  orderDate            DateTime
  expectedDeliveryDate DateTime?
  status               String        @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, PARTIALLY_FULFILLED, COMPLETED, CANCELLED
  invoicingStatus      String        @default("UNINVOICED") // UNINVOICED, PARTIALLY_INVOICED, FULLY_INVOICED
  placeOfSupply        String        // 2-digit Indian State Code
  isInterState         Boolean       @default(false)
  subtotal             Float         @default(0)
  cgstTotal            Float         @default(0)
  sgstTotal            Float         @default(0)
  igstTotal            Float         @default(0)
  taxTotal             Float         @default(0)
  discountTotal        Float         @default(0)
  grandTotal           Float         @default(0)
  notes                String?
  isArchived           Boolean       @default(false)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  organization         Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer             Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vendor               Vendor?       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  items                OrderItem[]
  invoices             Invoice[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId, type, status, isArchived])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  productId     String?
  description   String
  hsnSacCode        String
  quantity          Float    @default(1)
  invoicedQuantity  Float    @default(0)
  fulfilledQuantity Float    @default(0)
  unit              String   @default("NOS")
  unitPrice     Float
  discount      Float    @default(0)
  taxableAmount Float
  gstRate       Float
  cgstRate      Float    @default(0)
  cgstAmount    Float    @default(0)
  sgstRate      Float    @default(0)
  sgstAmount    Float    @default(0)
  igstRate      Float    @default(0)
  igstAmount    Float    @default(0)
  totalAmount   Float

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  type           String        @default("SALES") // SALES, PURCHASE
  customerId     String?
  vendorId       String?
  orderId        String?
  invoiceNumber  String        // e.g. EXP-2026-001
  invoiceDate    DateTime
  dueDate        DateTime
  placeOfSupply  String        // 2-digit Indian State Code
  isInterState   Boolean       @default(false) // true: IGST, false: CGST + SGST
  status         String        @default("DRAFT") // DRAFT, ISSUED, PAID, PARTIALLY_PAID, OVERDUE, CANCELLED
  subtotal       Float         @default(0)
  cgstTotal      Float         @default(0)
  sgstTotal      Float         @default(0)
  igstTotal      Float         @default(0)
  taxTotal       Float         @default(0)
  discountTotal  Float         @default(0)
  grandTotal     Float         @default(0)
  amountPaid     Float         @default(0)
  notes          String?
  terms          String?
  isArchived     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer?     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vendor         Vendor?       @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  order          Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  items          InvoiceItem[]
  payments       Payment[]
  attachments    Attachment[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, type, status, isArchived])
  @@index([customerId])
  @@index([vendorId])
}

model InvoiceItem {
  id            String   @id @default(cuid())
  invoiceId     String
  productId     String?
  description   String
  hsnSacCode    String   // HSN/SAC Indian Tax classification code
  quantity      Float    @default(1)
  unit          String   @default("NOS")
  unitPrice     Float
  discount      Float    @default(0)
  taxableAmount Float
  gstRate       Float    // Slabs: 0, 5, 12, 18, 28 (%)
  cgstRate      Float    @default(0)
  cgstAmount    Float    @default(0)
  sgstRate      Float    @default(0)
  sgstAmount    Float    @default(0)
  igstRate      Float    @default(0)
  igstAmount    Float    @default(0)
  totalAmount   Float

  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model Payment {
  id              String        @id @default(cuid())
  organizationId  String
  paymentNumber   String        // e.g. REC-2026-001 or PAY-2026-001
  type            String        // INCOMING (from customer), OUTGOING (to vendor)
  invoiceId       String?
  customerId      String?
  vendorId        String?
  amount          Float
  paymentDate     DateTime
  paymentMode     String        @default("BANK_TRANSFER") // BANK_TRANSFER, UPI, CHEQUE, CASH, CARD
  referenceNumber String?
  notes           String?
  status          String        @default("COMPLETED") // COMPLETED, BOUNCED, VOID
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  vendor          Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  @@unique([organizationId, paymentNumber])
  @@unique([organizationId, referenceNumber])
  @@index([organizationId, type])
  @@index([invoiceId])
}

model DocumentSequence {
  id             String       @id @default(cuid())
  organizationId String
  type           String       // SALES_ORDER, PURCHASE_ORDER, SALES_INVOICE, PURCHASE_INVOICE, INCOMING_PAYMENT, OUTGOING_PAYMENT
  year           Int          // Calendar or financial year
  currentValue   Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, type, year])
  @@index([organizationId])
}

model BusinessExpense {
  id              String       @id @default(cuid())
  organizationId  String
  vendorId        String?
  category        String       // OFFICE, TRAVEL, UTILITIES, RENT, SALARIES, MARKETING, OTHER
  expenseDate     DateTime
  amount          Float
  taxAmount       Float        @default(0)
  gstRate         Float?       // Slabs: 0, 5, 12, 18, 28 (%)
  gstin           String?
  hsnSacCode      String?
  isItcEligible   Boolean      @default(true) // Input Tax Credit eligibility under GST
  paymentMethod   String       @default("BANK_TRANSFER") // BANK_TRANSFER, UPI, CARD, CASH
  paymentStatus   String       @default("PAID") // PAID, PENDING
  referenceNumber String?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor          Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  attachments     Attachment[]

  @@index([organizationId, expenseDate])
  @@index([vendorId])
}

// -----------------------------------------------------------------------------
// 5. Personal Financial Management (Individual Domain)
// -----------------------------------------------------------------------------

model PersonalAccount {
  id                 String                @id @default(cuid())
  userId             String
  name               String                // e.g. HDFC Salary, SBI Savings, Cash
  type               String                @default("SAVINGS") // SAVINGS, CURRENT, CREDIT_CARD, INVESTMENT, WALLET, CASH
  currency           String                @default("INR")
  initialBalance     Float                 @default(0)
  currentBalance     Float                 @default(0)
  accountNumberLast4 String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       PersonalTransaction[]

  @@index([userId])
}

model PersonalCategory {
  id           String                @id @default(cuid())
  userId       String
  name         String                // e.g. Groceries, Fuel, Salary, Utilities
  type         String                // INCOME, EXPENSE
  icon         String?
  color        String?
  createdAt    DateTime              @default(now())

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions PersonalTransaction[]
  budgets      PersonalBudget[]

  @@index([userId])
}

model PersonalTransaction {
  id              String            @id @default(cuid())
  userId          String
  accountId       String
  categoryId      String?
  type            String            // INCOME, EXPENSE, TRANSFER
  amount          Float
  transactionDate DateTime
  payee           String?
  description     String?
  isReimbursable  Boolean           @default(false) // Linkable to business expense reimbursement
  isReimbursed    Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account         PersonalAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category        PersonalCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  attachments     Attachment[]

  @@index([userId, transactionDate])
  @@index([accountId])
  @@index([categoryId])
}

model PersonalBudget {
  id         String           @id @default(cuid())
  userId     String
  categoryId String
  amount     Float
  period     String           @default("MONTHLY") // MONTHLY, YEARLY
  month      Int?
  year       Int
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   PersonalCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, year, month])
  @@index([userId])
}

// -----------------------------------------------------------------------------
// 6. Polymorphic Document Attachments
// -----------------------------------------------------------------------------

model Attachment {
  id                    String               @id @default(cuid())
  organizationId        String?
  userId                String
  fileName              String
  fileUrl               String
  fileType              String
  fileSize              Int
  invoiceId             String?
  businessExpenseId     String?
  personalTransactionId String?
  createdAt             DateTime             @default(now())

  organization          Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice               Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  businessExpense       BusinessExpense?     @relation(fields: [businessExpenseId], references: [id], onDelete: Cascade)
  personalTransaction   PersonalTransaction? @relation(fields: [personalTransactionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
}
